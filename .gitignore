# compiled python files
*.pyc

# folder view configuration files
.DS_Store
Desktop.ini

# thumbnail cache files
._*
Thumbs.db

# files that might appear on external disks
.Spotlight-V100
.Trashes

# non essential
extra*
.extra*
test*
.test*

# sensitive data
.secret*

# zsh
.zprofile
.zcompdump
.zsh_sessions
.zsh_history

# bash
.bash_profile

# auto-cloned plugins (not tracked, installed on first use)
.config/zsh/plugins
.config/tmux/plugins

# config dirs to ignore
.config/jupyter
.config/htop
.config/docker
.config/colima
.config/swiftpm
.config/uv
.config/uvx
.config/fish
.config/vim
.config/ruff

