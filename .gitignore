TODO.md

# opencode (auto-generated by plugin system)
.config/opencode/node_modules
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock
.config/opencode/.gitignore
.config/opencode/opencode.jsonc

# .local — only track custom scripts, ignore everything else
.local/share
.local/state
.local/bin/*
!.local/bin/dani
!.local/bin/env
!.local/bin/fry
!.local/bin/mvdw
!.local/bin/tmux-init
