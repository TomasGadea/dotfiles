{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/tomas/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "codex-style@lkm-schulz-plugins": true
  },
  "extraKnownMarketplaces": {
    "lkm-schulz-plugins": {
      "source": {
        "source": "github",
        "repo": "lkm-schulz/claude-plugins"
      }
    }
  },
  "outputStyle": "Simple",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "codex-style@lkm-schulz-plugins": {
      "options": {
        "replyStyle": "bar"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
