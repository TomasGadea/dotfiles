# portable ls color: GNU uses --color, BSD/macOS uses -G (+ CLICOLOR already set)
if ls --color=auto . >/dev/null 2>&1; then
    alias ls='ls --color=auto'   # GNU/Linux
else
    alias ls='ls -G'             # BSD/macOS
fi
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias clear='printf "\033[H\033[2J"'
alias g="git"
alias gst="git status"
alias gd="git diff"
alias ga="git add"
alias gaa="git add -A"
alias gc="git commit"
alias gp="git push origin HEAD"
alias gl="git pull"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"
alias gpf="git push --force"
alias vim="nvim"
alias v="nvim"
alias vv="nvim ."
alias t="tmux"
alias ti="tmux-init"
alias tk="tmux kill-session"


# DRIBIA
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'


# personal logs
dj() {
  local dir="$JOURNAL_DIR/$(date +'%Y')/$(date +'%m_%B' | tr '[:upper:]' '[:lower:]')"
  mkdir -p "$dir" && cd "$dir" && daily
}
alias oc="opencode"
alias meetings="cd '${MEETINGS_DIR}'"

alias master="cd '${XDG_DOCUMENTS_DIR}/master'"


# Temporal
alias tmpwf='temporal workflow show --workflow-id'
alias tmplist='temporal workflow list --limit 20'
alias tmpfailed='temporal workflow list --query "ExecutionStatus=\"Failed\"" --limit 20'
# extract job_id from a Temporal workflow URL
solveid() { echo "$1" | sed 's/^.*solve-//' | cut -d/ -f1; }
